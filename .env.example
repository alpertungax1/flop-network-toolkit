# ==============================================================================
# FLOP NETWORK TOOLKIT - ENVIRONMENT TEMPLATE
# Copy to .env and configure your variables
# ==============================================================================

# Network Profile (devnet | testnet | local)
FLOP_NETWORK=devnet
FLOP_RPC_URL=wss://rpc.devnet.flop.network
FLOP_GATEWAY_URL=https://api.flop.network
FLOP_FAUCET_URL=https://faucet.flop.network
FLOP_EXPLORER_URL=https://explorer.devnet.flop.network

# EVM Identity for SIWE Verified Human Faucet Claim
# Option A: Private key for automated headless signing
EVM_PRIVATE_KEY=

# Option B: Chrome Remote Debugging port for extension signing (e.g. Rabby / MetaMask)
BROWSER_CDP_PORT=9222

# Substrate FLOP Recipient Address (SS58 format starting with 5...)
FLOP_RECIPIENT_ADDRESS=

# Keystore Configuration
FLOP_KEYSTORE_PATH=./flop_keystore.json
FLOP_KEYSTORE_PASSWORD=
